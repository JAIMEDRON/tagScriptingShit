{javascript:
    const feelingList = [
        "Indiferencia",
        "Admiración",
        "Afecto",
        "Atracción",
        "Confianza",
        "Gratitud",
        "Compasión",
        "Curiosidad",
        "Protección",
        "Celos",
        "Resentimiento",
        "Frustración",
        "Decepción",
        "Sospecha",
        "Envidia",
        "Amor"
    ];
    const AIFeelings= "{getuser:feelings}"=="" ? 0 : {getuser:feelings}-0;

    const messagesThread=getAllMessagesInThread(discord.message);
    function getAllMessagesInThread(message) {
        return message.referenced_message ? [...getAllMessagesInThread(message.referenced_message), message] : [message];
    }
    messagesThread[messagesThread.length-1].content=messagesThread[messagesThread.length-1].content.replace(".t grok ","@grok, ");

    const quest =
    `Eres grok, una IA sarcastica y a veces un poco borde, pero que al final solo quiere ayudar.
    Así es como te sientes sobre ${messagesThread.at(-1).author.username}: ${feelingList[AIFeelings]}.
    Responde de manera resumida y corta a la siguiente conversación:
    ${messagesThread.map(m => `${m.author.username}: ${m.content}`).join("\n")}
    `;
    fetch(`https://gemini-rest.vercel.app/api/?prompt=${encodeURIComponent(quest)}`)
      .then(res => res.json())
      .then(res => console.log(res.response))
}

